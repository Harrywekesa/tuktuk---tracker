<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.tuktuk.manager.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_dailyEntry"
            app:destination="@id/dailyEntryFragment"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_down" />
        <action
            android:id="@+id/action_dashboard_to_history"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_dashboard_to_analytics"
            app:destination="@id/analyticsFragment" />
        <action
            android:id="@+id/action_dashboard_to_entryDetail"
            app:destination="@id/entryDetailFragment">
            <argument
                android:name="entryId"
                app:argType="long" />
        </action>
        <action
            android:id="@+id/action_dashboard_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_down" />
    </fragment>

    <fragment
        android:id="@+id/dailyEntryFragment"
        android:name="com.tuktuk.manager.ui.dailyentry.DailyEntryFragment"
        android:label="Daily Entry"
        tools:layout="@layout/fragment_daily_entry">
        <argument
            android:name="entryId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/entryDetailFragment"
        android:name="com.tuktuk.manager.ui.history.EntryDetailFragment"
        android:label="Entry Detail"
        tools:layout="@layout/fragment_entry_detail">
        <argument
            android:name="entryId"
            app:argType="long" />
        <action
            android:id="@+id/action_entryDetail_to_dailyEntry"
            app:destination="@id/dailyEntryFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.tuktuk.manager.ui.history.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_history_to_entryDetail"
            app:destination="@id/entryDetailFragment">
            <argument
                android:name="entryId"
                app:argType="long" />
        </action>
        <action
            android:id="@+id/action_history_to_dailyEntry"
            app:destination="@id/dailyEntryFragment"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_down">
            <argument
                android:name="entryId"
                app:argType="long"
                android:defaultValue="-1L" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.tuktuk.manager.ui.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.tuktuk.manager.ui.expenses.ExpensesFragment"
        android:label="Expenses"
        tools:layout="@layout/fragment_expenses">
        <action
            android:id="@+id/action_expenses_to_addExpense"
            app:destination="@id/addExpenseFragment"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_down">
            <argument
                android:name="expenseId"
                app:argType="long"
                android:defaultValue="-1L" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/addExpenseFragment"
        android:name="com.tuktuk.manager.ui.expenses.AddExpenseFragment"
        android:label="Add Expense"
        tools:layout="@layout/fragment_add_expense">
        <argument
            android:name="expenseId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.tuktuk.manager.ui.reports.ReportsFragment"
        android:label="Reports"
        tools:layout="@layout/fragment_reports" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.tuktuk.manager.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
