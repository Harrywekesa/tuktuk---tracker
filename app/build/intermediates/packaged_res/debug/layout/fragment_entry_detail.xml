<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="?attr/colorSurface" app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:paddingTop="16dp" app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface" app:title="Entry Detail"
            app:titleTextColor="?attr/colorOnSurface"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingBottom="24dp" app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Status badges -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">
                <TextView android:id="@+id/tv_detail_date" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:textSize="16sp" android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground" tools:text="01 March 2026"/>
                <TextView android:id="@+id/tv_detail_target_status" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textStyle="bold" android:layout_marginEnd="8dp"
                    tools:text="✅ Target Hit"/>
                <TextView android:id="@+id/tv_detail_fuel_status" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textStyle="bold" tools:text="⚠️ HIGH"/>
            </LinearLayout>

            <!-- Shift -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp"
                app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Time In" android:textSize="11sp" android:alpha="0.5"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_detail_time_in" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="16sp"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                            tools:text="07:00"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Time Out" android:textSize="11sp" android:alpha="0.5"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_detail_time_out" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="16sp"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                            tools:text="18:00"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Income & Fuel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp"
                app:cardElevation="0dp" app:cardBackgroundColor="@color/brand_navy_medium">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Gross Income" android:textSize="11sp" android:textColor="#80FFFFFF"/>
                            <TextView android:id="@+id/tv_detail_gross" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="22sp"
                                android:textStyle="bold" android:textColor="@color/brand_orange"
                                tools:text="KSh 1,900"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Fuel Cost" android:textSize="11sp" android:textColor="#80FFFFFF"/>
                            <TextView android:id="@+id/tv_detail_fuel" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="22sp"
                                android:textStyle="bold" android:textColor="@color/chart_fuel"
                                tools:text="KSh 500"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Net Profit" android:textSize="11sp" android:textColor="#80FFFFFF"/>
                            <TextView android:id="@+id/tv_detail_net" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="22sp"
                                android:textStyle="bold" android:textColor="@color/brand_teal"
                                tools:text="KSh 1,400"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Fuel %" android:textSize="11sp" android:textColor="#80FFFFFF"/>
                            <TextView android:id="@+id/tv_detail_fuel_pct" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="22sp"
                                android:textStyle="bold" android:textColor="#FFFFFF"
                                tools:text="26.3%"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4-way split -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp"
                app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="25% EQUAL SPLIT" android:textSize="11sp" android:textStyle="bold"
                        android:alpha="0.4" android:textColor="?attr/colorOnSurface"
                        android:letterSpacing="0.1" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:weightSum="2">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="💼 Owner Salary" android:textSize="11sp"
                                android:textColor="?attr/colorOnSurface" android:alpha="0.6"/>
                            <TextView android:id="@+id/tv_detail_owner" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="18sp"
                                android:textStyle="bold" android:textColor="@color/chart_owner"
                                tools:text="KSh 350"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🛺 Rider Pay" android:textSize="11sp"
                                android:textColor="?attr/colorOnSurface" android:alpha="0.6"/>
                            <TextView android:id="@+id/tv_detail_rider" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="18sp"
                                android:textStyle="bold" android:textColor="@color/chart_rider"
                                tools:text="KSh 350"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:weightSum="2">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🔧 Maintenance" android:textSize="11sp"
                                android:textColor="?attr/colorOnSurface" android:alpha="0.6"/>
                            <TextView android:id="@+id/tv_detail_maint" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="18sp"
                                android:textStyle="bold" android:textColor="@color/chart_maintenance"
                                tools:text="KSh 350"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="📈 Biz Profit" android:textSize="11sp"
                                android:textColor="?attr/colorOnSurface" android:alpha="0.6"/>
                            <TextView android:id="@+id/tv_detail_biz" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="18sp"
                                android:textStyle="bold" android:textColor="@color/chart_profit"
                                tools:text="KSh 350"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bank Deposit -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp"
                app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Float Deducted" android:textSize="11sp" android:alpha="0.5"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_detail_float" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="18sp"
                            android:textStyle="bold" android:textColor="@color/chart_fuel"
                            tools:text="KSh 200"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🏦 Bank Deposit" android:textSize="11sp"
                            android:textColor="@color/brand_green" android:alpha="0.8"/>
                        <TextView android:id="@+id/tv_detail_bank_deposit" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/brand_green"
                            tools:text="KSh 500"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KM Details -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_km_details"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" android:visibility="gone"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📍 KM DETAILS" android:textSize="11sp" android:textStyle="bold"
                        android:alpha="0.4" android:textColor="?attr/colorOnSurface"
                        android:letterSpacing="0.1" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:weightSum="3">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Start Odo" android:textSize="10sp" android:alpha="0.5"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView android:id="@+id/tv_detail_start_odo" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                                tools:text="1,200 KM"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="End Odo" android:textSize="10sp" android:alpha="0.5"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView android:id="@+id/tv_detail_end_odo" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                                tools:text="1,277 KM"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Business KM" android:textSize="10sp" android:alpha="0.5"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView android:id="@+id/tv_detail_business_km" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="@color/brand_teal"
                                tools:text="67 KM"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Income / KM" android:textSize="10sp" android:alpha="0.5"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView android:id="@+id/tv_detail_income_pkm" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="@color/brand_teal"
                                tools:text="KSh 28.4/KM"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Fuel / KM" android:textSize="10sp" android:alpha="0.5"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView android:id="@+id/tv_detail_fuel_pkm" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="@color/chart_fuel"
                                tools:text="KSh 7.5/KM"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notes -->
            <TextView android:id="@+id/tv_detail_notes" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                android:padding="16dp" android:background="?attr/colorSurface"
                android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                android:alpha="0.7" android:visibility="gone"
                tools:text="Notes here" />

            <!-- Edit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_entry"
                android:layout_width="match_parent" android:layout_height="56dp"
                style="@style/Widget.TukTukManager.Button.Primary"
                android:text="Edit This Entry" android:textSize="16sp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
