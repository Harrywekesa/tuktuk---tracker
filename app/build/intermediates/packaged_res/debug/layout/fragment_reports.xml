<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="?attr/colorSurface" android:orientation="vertical"
            android:paddingStart="20dp" android:paddingTop="52dp"
            android:paddingEnd="20dp" android:paddingBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="REPORTS" android:textColor="@color/brand_orange"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton android:id="@+id/btn_prev_month" android:layout_width="36dp"
                    android:layout_height="36dp" android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_chevron_left" android:tint="?attr/colorOnSurface"
                    android:contentDescription="Previous"/>

                <TextView android:id="@+id/tv_report_month" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="center" android:text="March 2026"
                    android:textColor="?attr/colorOnSurface" android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageButton android:id="@+id/btn_next_month" android:layout_width="36dp"
                    android:layout_height="36dp" android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_chevron_right" android:tint="?attr/colorOnSurface"
                    android:contentDescription="Next"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Export Options -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginTop="20dp"
            android:text="GENERATE REPORT" android:textColor="?attr/colorOnBackground"
            android:textSize="11sp" android:textStyle="bold" android:alpha="0.5"
            android:letterSpacing="0.1"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp" android:orientation="horizontal" android:weightSum="2">

            <!-- PDF Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📄" android:textSize="32sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="PDF Report"
                        android:textColor="?attr/colorOnSurface" android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Full report with all entries, expenses, and summary"
                        android:textColor="?attr/colorOnSurface" android:textSize="11sp"
                        android:alpha="0.6" android:layout_marginTop="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_export_pdf"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.TukTukManager.Button.Primary"
                        android:text="Export PDF" android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Excel Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📊" android:textSize="32sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Excel Report"
                        android:textColor="?attr/colorOnSurface" android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="3 sheets: Summary, Daily Entries, Expenses"
                        android:textColor="?attr/colorOnSurface" android:textSize="11sp"
                        android:alpha="0.6" android:layout_marginTop="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_export_excel"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:text="Export Excel" android:textSize="13sp"
                        android:textColor="@color/brand_orange"
                        app:strokeColor="@color/brand_orange"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Generating progress -->
        <LinearLayout android:id="@+id/layout_generating" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" android:layout_marginEnd="16dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:visibility="gone">
            <ProgressBar android:id="@+id/progress_generating" android:layout_width="24dp"
                android:layout_height="24dp" android:indeterminate="true"
                android:indeterminateTint="@color/brand_orange"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="Generating report…"
                android:textColor="?attr/colorOnBackground" android:textSize="14sp"/>
        </LinearLayout>

        <!-- Report Ready Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_report_ready"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp" android:visibility="gone"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:strokeWidth="1.5dp" app:strokeColor="@color/brand_orange"
            app:cardBackgroundColor="@color/brand_orange_08">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:id="@+id/tv_report_ready_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅ Report ready" android:textSize="16sp"
                    android:textStyle="bold" android:textColor="@color/brand_orange"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal" android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_report"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        style="@style/Widget.TukTukManager.Button.Primary"
                        android:text="View" android:textSize="14sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_report"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:text="Share" android:textColor="@color/brand_orange"
                        app:strokeColor="@color/brand_orange" android:textSize="14sp"/>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- What's included -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="WHAT'S INCLUDED" android:textSize="11sp" android:textStyle="bold"
                    android:alpha="0.5" android:textColor="?attr/colorOnSurface"
                    android:letterSpacing="0.08" android:layout_marginBottom="12dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅  Monthly financial summary" android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅  All daily entries with full breakdown" android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅  Income per KM and fuel per KM" android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅  Fuel efficiency status per day" android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅  All expenses and maintenance log" android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅  Net maintenance balance" android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
