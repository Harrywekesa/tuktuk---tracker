<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="?attr/colorSurface" android:orientation="vertical"
            android:paddingStart="20dp" android:paddingTop="52dp"
            android:paddingEnd="20dp" android:paddingBottom="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SETTINGS" android:textColor="@color/brand_orange"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tuk-Tuk Manager" android:textColor="?attr/colorOnSurface"
                android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Theme -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginTop="20dp"
            android:text="APP THEME" android:textColor="?attr/colorOnBackground"
            android:textSize="11sp" android:textStyle="bold" android:alpha="0.5"
            android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <RadioGroup android:id="@+id/rg_theme" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="16dp">
                <RadioButton android:id="@+id/rb_theme_dark" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="🌙  Dark Theme"
                    android:textColor="?attr/colorOnSurface" android:textSize="15sp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
                <RadioButton android:id="@+id/rb_theme_light" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="☀️  Light Theme"
                    android:textColor="?attr/colorOnSurface" android:textSize="15sp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
                <RadioButton android:id="@+id/rb_theme_system" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="⚙️  Follow System"
                    android:textColor="?attr/colorOnSurface" android:textSize="15sp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <!-- Names -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginTop="20dp"
            android:text="PEOPLE" android:textColor="?attr/colorOnBackground"
            android:textSize="11sp" android:textStyle="bold" android:alpha="0.5"
            android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.TukTukManager.TextInputLayout"
                    android:hint="Owner Name" app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/brand_orange">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_owner_name" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textCapWords"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    style="@style/Widget.TukTukManager.TextInputLayout"
                    android:hint="Rider Name" app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/brand_orange">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_rider_name" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textCapWords"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Targets -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginTop="20dp"
            android:text="TARGETS &amp; RULES" android:textColor="?attr/colorOnBackground"
            android:textSize="11sp" android:textStyle="bold" android:alpha="0.5"
            android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.TukTukManager.TextInputLayout"
                    android:hint="Daily Gross Target (KSh)" app:prefixText="KSh ">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_daily_target" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.TukTukManager.TextInputLayout"
                    android:hint="Minimum Gross (KSh)" app:prefixText="KSh ">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_min_gross" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.TukTukManager.TextInputLayout"
                    android:hint="Starting Float (KSh)" app:prefixText="KSh ">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_float" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.TukTukManager.TextInputLayout"
                    android:hint="Commute KM (one way)" app:suffixText="KM">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_commute_km" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    style="@style/Widget.TukTukManager.TextInputLayout"
                    android:hint="Target Working Days / Month" app:suffixText="days">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_working_days" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginStart="16dp" android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            style="@style/Widget.TukTukManager.Button.Primary"
            android:text="Save Settings" android:textSize="16sp"/>

        <!-- Cloud Sync -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginTop="20dp"
            android:text="CLOUD SYNC" android:textColor="?attr/colorOnBackground"
            android:textSize="11sp" android:textStyle="bold" android:alpha="0.5"
            android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="☁️  Firebase Sync" android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Local-first. Syncs when online."
                        android:textColor="?attr/colorOnSurface" android:textSize="12sp"
                        android:alpha="0.6"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sync_now"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="Sync Now" android:textColor="@color/brand_orange"
                    app:strokeColor="@color/brand_orange" android:textSize="13sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Legacy Data Import -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginTop="20dp"
            android:text="DATA MIGRATION" android:textColor="?attr/colorOnBackground"
            android:textSize="11sp" android:textStyle="bold" android:alpha="0.5"
            android:letterSpacing="0.1"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📥 Import Excel Data" android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Loads historical data from bundle."
                        android:textColor="?attr/colorOnSurface" android:textSize="12sp"
                        android:alpha="0.6"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_legacy"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="Import" android:textColor="@color/brand_orange"
                    app:strokeColor="@color/brand_orange" android:textSize="13sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tuk-Tuk Manager" android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Version 1.0.0  •  Your business, tracked."
                    android:textColor="?attr/colorOnSurface" android:textSize="12sp"
                    android:alpha="0.6" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
