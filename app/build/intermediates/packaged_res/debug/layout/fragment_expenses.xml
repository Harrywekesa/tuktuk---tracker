<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="52dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EXPENSES" android:textColor="@color/brand_orange"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">

                <ImageButton android:id="@+id/btn_prev_month" android:layout_width="36dp"
                    android:layout_height="36dp" android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_chevron_left" android:tint="?attr/colorOnSurface"
                    android:contentDescription="Previous"/>

                <TextView android:id="@+id/tv_expense_month" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="center" android:text="March 2026"
                    android:textColor="?attr/colorOnSurface" android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageButton android:id="@+id/btn_next_month" android:layout_width="36dp"
                    android:layout_height="36dp" android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_chevron_right" android:tint="?attr/colorOnSurface"
                    android:contentDescription="Next"/>

            </LinearLayout>

            <!-- Maintenance Balance -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal" android:weightSum="2">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Total Expenses" android:textSize="10sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView android:id="@+id/tv_total_expenses" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="@color/status_alert"
                        tools:text="KSh 0"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Maintenance Balance" android:textSize="10sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView android:id="@+id/tv_maint_balance" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="16sp"
                        android:textStyle="bold" android:textColor="@color/status_good"
                        tools:text="KSh 2,875"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <TextView android:id="@+id/tv_no_expenses" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="32dp" android:gravity="center"
            android:text="No expenses this month.\nTap + to log a repair or cost."
            android:textColor="?attr/colorOnBackground" android:textSize="14sp"
            android:alpha="0.5" android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_expenses" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:paddingTop="8dp" android:paddingBottom="80dp" android:clipToPadding="false"/>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Add expense"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/brand_navy"
        app:backgroundTint="@color/brand_orange"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
