<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="52dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANALYTICS"
                android:textColor="@color/brand_orange"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- Month Navigator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_prev_month"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_chevron_left"
                    android:tint="?attr/colorOnSurface"
                    android:contentDescription="Previous month" />

                <TextView
                    android:id="@+id/tv_month_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="March 2026"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="March 2026" />

                <ImageButton
                    android:id="@+id/btn_next_month"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="?attr/colorOnSurface"
                    android:contentDescription="Next month" />

            </LinearLayout>
        </LinearLayout>

        <!-- Key Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="GROSS" android:textSize="9sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface" android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tv_stat_gross" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/brand_orange"
                        tools:text="16,100"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="NET" android:textSize="9sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface" android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tv_stat_net" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/brand_teal"
                        tools:text="11,500"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="FUEL" android:textSize="9sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface" android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tv_stat_fuel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/chart_fuel"
                        tools:text="4,600"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Income Trend Chart -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="📈 INCOME TREND"
                        android:textColor="?attr/colorOnSurface" android:textSize="11sp"
                        android:textStyle="bold" android:alpha="0.5" android:letterSpacing="0.08"/>
                    <!-- Legend -->
                    <View android:layout_width="12dp" android:layout_height="3dp"
                        android:background="@color/brand_orange" android:layout_marginEnd="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Gross " android:textSize="10sp" android:textColor="?attr/colorOnSurface"/>
                    <View android:layout_width="12dp" android:layout_height="3dp"
                        android:background="@color/brand_teal" android:layout_marginEnd="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Net" android:textSize="10sp" android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_income_trend"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Money Breakdown Pie + Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Pie Chart -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💰 SPLIT" android:textSize="10sp" android:textStyle="bold"
                        android:alpha="0.5" android:textColor="?attr/colorOnSurface"
                        android:letterSpacing="0.08" android:layout_marginBottom="8dp"/>
                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/chart_breakdown"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"/>
                    <!-- Legend -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginTop="8dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="10dp" android:layout_height="10dp"
                                android:background="@color/chart_owner"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text=" Owner" android:textSize="10sp" android:textColor="?attr/colorOnSurface"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="10dp" android:layout_height="10dp"
                                android:background="@color/chart_rider"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text=" Rider" android:textSize="10sp" android:textColor="?attr/colorOnSurface"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="10dp" android:layout_height="10dp"
                                android:background="@color/chart_maintenance"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text=" Maint" android:textSize="10sp" android:textColor="?attr/colorOnSurface"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="10dp" android:layout_height="10dp"
                                android:background="@color/chart_profit"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text=" Profit" android:textSize="10sp" android:textColor="?attr/colorOnSurface"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="10dp" android:layout_height="10dp"
                                android:background="@color/chart_fuel"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text=" Fuel" android:textSize="10sp" android:textColor="?attr/colorOnSurface"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Performance Stats -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎯 PERFORMANCE" android:textSize="10sp" android:textStyle="bold"
                        android:alpha="0.5" android:textColor="?attr/colorOnSurface"
                        android:letterSpacing="0.08" android:layout_marginBottom="12dp"/>

                    <include layout="@layout/item_stat_row"
                        android:id="@+id/stat_days_worked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <include layout="@layout/item_stat_row"
                        android:id="@+id/stat_days_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <include layout="@layout/item_stat_row"
                        android:id="@+id/stat_days_below"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <include layout="@layout/item_stat_row"
                        android:id="@+id/stat_avg_gross"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <include layout="@layout/item_stat_row"
                        android:id="@+id/stat_best_day"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <include layout="@layout/item_stat_row"
                        android:id="@+id/stat_worst_day"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Fuel Status Bar Chart -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⛽ FUEL STATUS DAYS" android:textSize="11sp" android:textStyle="bold"
                    android:alpha="0.5" android:textColor="?attr/colorOnSurface"
                    android:letterSpacing="0.08" android:layout_marginBottom="8dp"/>

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chart_fuel_days"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"/>

                <!-- Fuel detail stats -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal" android:weightSum="3">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="✅ Good" android:textSize="11sp" android:textColor="@color/status_good"/>
                        <TextView android:id="@+id/tv_stat_fuel_good" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/status_good" tools:text="5"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="days" android:textSize="10sp" android:alpha="0.5"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⚠️ High" android:textSize="11sp" android:textColor="@color/status_warning"/>
                        <TextView android:id="@+id/tv_stat_fuel_high" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/status_warning" tools:text="3"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="days" android:textSize="10sp" android:alpha="0.5"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🔴 Alert" android:textSize="11sp" android:textColor="@color/status_alert"/>
                        <TextView android:id="@+id/tv_stat_fuel_alert" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/status_alert" tools:text="2"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="days" android:textSize="10sp" android:alpha="0.5"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Finance Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🏦 FINANCIAL SUMMARY" android:textSize="11sp" android:textStyle="bold"
                    android:alpha="0.5" android:textColor="?attr/colorOnSurface"
                    android:letterSpacing="0.08" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="12dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Bank Balance" android:textSize="10sp" android:alpha="0.6"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_stat_bank_balance" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="@color/brand_green"
                            tools:text="KSh 3,550"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Maint. Balance" android:textSize="10sp" android:alpha="0.6"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_stat_maint_balance" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="@color/chart_maintenance"
                            tools:text="KSh 2,875"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Profit Margin" android:textSize="10sp" android:alpha="0.6"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_stat_profit_margin" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="@color/brand_teal"
                            tools:text="71.4%"/>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="3">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Total KMs" android:textSize="10sp" android:alpha="0.6"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_stat_km" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="@color/brand_yellow"
                            tools:text="325 KM"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Fuel %" android:textSize="10sp" android:alpha="0.6"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_stat_fuel_pct" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="@color/chart_fuel"
                            tools:text="28.6%"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Avg/Day" android:textSize="10sp" android:alpha="0.6"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_stat_avg_gross" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                            tools:text="KSh 1,610"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Best / Worst day -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@color/status_good_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏆 Best Day" android:textSize="11sp"
                        android:textColor="@color/status_good" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_stat_best_day" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="18sp"
                        android:textStyle="bold" android:textColor="@color/status_good"
                        android:layout_marginTop="4dp" tools:text="KSh 2,900"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp"
                app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@color/status_alert_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📉 Worst Day" android:textSize="11sp"
                        android:textColor="@color/status_alert" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_stat_worst_day" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="18sp"
                        android:textStyle="bold" android:textColor="@color/status_alert"
                        android:layout_marginTop="4dp" tools:text="KSh 400"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Days worked / target / below stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="4dp"
                app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Days Worked" android:textSize="10sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface" android:gravity="center"/>
                    <TextView android:id="@+id/tv_stat_days_worked" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="28sp"
                        android:textStyle="bold" android:textColor="@color/brand_yellow"
                        android:gravity="center" tools:text="10"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@color/status_good_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Hit Target" android:textSize="10sp"
                        android:textColor="@color/status_good" android:gravity="center"/>
                    <TextView android:id="@+id/tv_stat_days_target" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="28sp"
                        android:textStyle="bold" android:textColor="@color/status_good"
                        android:gravity="center" tools:text="3"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="4dp"
                app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:cardBackgroundColor="@color/status_alert_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Below Min" android:textSize="10sp"
                        android:textColor="@color/status_alert" android:gravity="center"/>
                    <TextView android:id="@+id/tv_stat_days_below" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="28sp"
                        android:textStyle="bold" android:textColor="@color/status_alert"
                        android:gravity="center" tools:text="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
