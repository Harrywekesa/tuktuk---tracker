<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="52dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HISTORY"
                android:textColor="@color/brand_orange"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <!-- Month Navigator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_prev_month"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_chevron_left"
                    android:tint="?attr/colorOnSurface"
                    android:contentDescription="Previous month"/>

                <TextView
                    android:id="@+id/tv_history_month"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="March 2026"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/btn_next_month"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_button"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="?attr/colorOnSurface"
                    android:contentDescription="Next month"/>

            </LinearLayout>

            <!-- Summary Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Days" android:textSize="10sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView android:id="@+id/tv_history_days" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/brand_yellow"
                        tools:text="10 days"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Gross" android:textSize="10sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView android:id="@+id/tv_history_summary_gross" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/brand_orange"
                        tools:text="16,100"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Net" android:textSize="10sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView android:id="@+id/tv_history_summary_net" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/brand_teal"
                        tools:text="11,500"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Banked" android:textSize="10sp" android:alpha="0.5"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView android:id="@+id/tv_history_summary_bank" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/brand_green"
                        tools:text="3,550"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- List -->
        <TextView
            android:id="@+id/tv_no_entries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp"
            android:gravity="center"
            android:text="No entries for this month"
            android:textColor="?attr/colorOnBackground"
            android:textSize="14sp"
            android:alpha="0.5"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
